# Halaman HTML selalu dicek ulang supaya update langsung terlihat
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/bib/*
  Cache-Control: no-cache

# Kode dan gaya: singkat. Setiap mengubah app.js/style.css/config.js, naikkan ?v= di index.html
/assets/*
  Cache-Control: public, max-age=300

/config.js
  Cache-Control: public, max-age=300

/data/*
  Cache-Control: public, max-age=300
  Content-Type: application/json; charset=utf-8

